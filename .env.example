# psycopg 3 => схема postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/keitaro_wrapper
KEITARO_BASE_URL=https://tlgk.host/admin_api/v1
KEITARO_API_KEY=put_your_key_here
# Пока false - обёртка ТОЛЬКО читает из Keitaro. Создание кампаний и Push блокируются.
KEITARO_WRITE_ENABLED=false
